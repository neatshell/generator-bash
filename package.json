{
  "name": "generator-bash",
  "version": "3.0.0",
  "description": "A generator to scaffold out a shell script, with arguments, options and flags handling",
  "author": {
    "name": "Claudio Stella",
    "email": "claudio.stella.ict@gmail.com"
  },
  "files": [
    "generators",
    "snippets"
  ],
  "main": "generators/app/index.js",
  "keywords": [
    "bash",
    "sh",
    "shell",
    "scaffolding",
    "unix",
    "generator",
    "yeoman",
    "yo",
    "yeoman-generator"
  ],
  "devDependencies": {
    "coveralls": "^3.1.1",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-config-xo": "^0.43.1",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.4",
    "yeoman-assert": "^3.1.1",
    "yeoman-test": "^2.7.0"
  },
  "engines": {
    "npm": ">= 4.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "lodash": "^4.17.21",
    "text-table": "^0.2.0",
    "yeoman-generator": "^7.4.0",
    "yosay": "^2.0.2"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "eslintConfig": {
    "extends": [
      "xo",
      "prettier"
    ],
    "env": {
      "jest": true,
      "node": true
    },
    "rules": {
      "prettier/prettier": "error"
    },
    "plugins": [
      "prettier"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest --passWithNoTests"
  },
  "license": "Apache-2.0"
}
