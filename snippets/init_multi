init() {
<% if (commands.length>0) {-%>
<% for(var i=0; i<commands.length; i++) {-%>
    add_command <%= commands[i].cmdName %>
<% } -%>
<% } -%>

    get_options "$@"
    get_arguments "$@"

    if [[ ! $(check_command ${command}) ]]; then
        usage
    else
        command_dir=$(dirname "${0}")
        command=${1}
        shift
        ${command_dir}/${command} "${@}"
    fi
}
